# Issue Triage Agent Environment Configuration

# Agent & LLM
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Pipeline Thresholds & Config
T_HIGH=0.85
C_MIN=0.5
MIN_BODY_CHARS=30
MAX_BODY_CHARS=6000
MAX_COMMENT_CHARS=1200
TOP_K=5
BOOTSTRAP_SAMPLES=1000

# Execution & Safety
ACTION_MODE=log
DRY_RUN=true
REPO_ALLOWLIST=

# Database / Storage
DATABASE_URL=postgresql://triage_user:triage_pass@localhost:5432/triage_db
SQLITE_DB_PATH=triage.sqlite

# GitHub Credentials (for live mode)
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
REVIEW_TOKEN=
